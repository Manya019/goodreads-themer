{
  "manifest_version": 3,
  "name": "Goodreads Glass Theme",
  "version": "0.7.7",
  "description": "A Goodreads theme customizer with accessible navigation icons and a modern appearance panel.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.goodreads.com/*"
      ],
      "css": [
        "themes.css"
      ],
      "js": [
        "content.js",
        "library.js"
      ],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "Goodreads Theme",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "host_permissions": [
    "https://*.gr-assets.com/*",
    "https://*.media-amazon.com/*",
    "https://*.ssl-images-amazon.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  }
}
